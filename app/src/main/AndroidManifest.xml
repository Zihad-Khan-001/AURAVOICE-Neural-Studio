<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone access for recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Audio playback -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Notifications for foreground audio recording on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service for long-running recording -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:label="AURAVOICE Neural Studio"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraVoice">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".audio.AudioRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
